# VPS staging only. Copy to /opt/hengxin-smart-image/infra/.env and replace every secret.
APP_ENV=development
ENABLE_TEST_JOBS=false
ENABLE_FIXTURE_EXECUTOR=false
ENABLE_CODEX_EXECUTOR=true
ENABLE_DEV_IDENTITY=false
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_NAME=VPS Test Admin
DEV_USER_ROLE=super_admin
# Phase 12.2: put the real values in the VPS-only .env, never in Git.
DINGTALK_CORP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_AGENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CALLBACK_DOMAIN=
DINGTALK_ADMIN_USER_IDS=
DINGTALK_ADMIN_USER_ID=
GENERATION_CONCURRENCY=1
CODEX_VERSION=0.156.1
CODEX_BINARY=/opt/hengxin-runtime/codex-0.156.1/codex
CODEX_AUTH_FILE=/home/codex/auth/auth.json
# Also set in /etc/hengxin-smart-image/worker.env for the native worker.
LOCAL_SKILL_ROOT=/opt/hengxin-skills
CODEX_TIMEOUT_SECONDS=3600
QUEUE_VISIBILITY_SECONDS=4200
POSTGRES_PASSWORD=replace-with-random-secret
MINIO_ACCESS_KEY=hengxin_vps_staging
MINIO_SECRET_KEY=replace-with-random-secret
MINIO_BUCKET=hx-vps-staging
API_PORT=18008
POSTGRES_PORT=15433
REDIS_PORT=16388
MINIO_PORT=15900
MINIO_CONSOLE_PORT=15901
# VPS 开发测试入口；如需仅本机访问可改为 127.0.0.1 并使用 SSH 隧道
WEB_BIND=0.0.0.0
WEB_PORT=18080
