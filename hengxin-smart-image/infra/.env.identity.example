# 独立身份服务；不提供业务数据库、图片存储或队列凭据。
# 使用 secrets.token_urlsafe(48) 分别生成两个不同密钥（至少32字符、12种ASCII字符）。
IDENTITY_REDIS_PASSWORD=
IDENTITY_PUBLIC_ORIGIN=http://localhost:3012
IDENTITY_DOMESTIC_SERVICE_KEY=
IDENTITY_OVERSEAS_SERVICE_KEY=
IDENTITY_DINGTALK_CORP_ID=
IDENTITY_DINGTALK_CLIENT_ID=
IDENTITY_DINGTALK_AGENT_ID=
IDENTITY_DINGTALK_CLIENT_SECRET=
IDENTITY_HTTP_PORT=8012
# 公网仅代理 /api/identity/v1/；禁止代理 /internal/。
# 内部业务服务通过受信任服务网络或本机端口访问，独立注入对应service key。
