[Unit]
Description=Hengxin idle CLI retention (requires explicit enablement)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codex
WorkingDirectory=/opt/hengxin-smart-image/backend
EnvironmentFile=/etc/hengxin/worker.env
ExecStart=/opt/hengxin-smart-image/backend/.venv/bin/python -m app.retention.worker --loop
Restart=on-failure
RestartSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
