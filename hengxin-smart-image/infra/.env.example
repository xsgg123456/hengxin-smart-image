# Copy to .env and replace passwords before starting. Local development only.
POSTGRES_PASSWORD=replace-with-random-hex
MINIO_ACCESS_KEY=hengxin-local
MINIO_SECRET_KEY=replace-with-random-hex
APP_ENV=development
ENABLE_TEST_JOBS=false
# Phase 8: fixture results are test-only; never enable on the development server.
ENABLE_FIXTURE_EXECUTOR=false
GENERATION_CONCURRENCY=1
FIXTURE_DELAY_SECONDS=3
API_PORT=8008
POSTGRES_PORT=55433
MINIO_PORT=59002
MINIO_CONSOLE_PORT=59003

# Phase 6: opt in only on a local development server; forbidden in production.
ENABLE_DEV_IDENTITY=false
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_NAME=本地联调用户
DEV_USER_ROLE=operator
MINIO_BUCKET=hengxin-smart-image
