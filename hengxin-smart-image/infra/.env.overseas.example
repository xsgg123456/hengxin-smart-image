# Compose input. Generate independent random hex passwords; never commit actual env.
HX_BUSINESS_CONTEXT=overseas
OVERSEAS_APP_ENV=development
# Optional unified login; set all three together. This key must be the overseas
# identity-service key, never the domestic key. URL is reachable internally.
OVERSEAS_IDENTITY_SERVICE_URL=
OVERSEAS_IDENTITY_SERVICE_KEY=
OVERSEAS_IDENTITY_PUBLIC_ORIGIN=
OVERSEAS_API_PORT=18008
OVERSEAS_POSTGRES_DB=hengxin_overseas
OVERSEAS_POSTGRES_PASSWORD=
OVERSEAS_OWNER_PASSWORD=
OVERSEAS_APP_PASSWORD=
OVERSEAS_REDIS_PASSWORD=
OVERSEAS_MINIO_ROOT_USER=
OVERSEAS_MINIO_ROOT_PASSWORD=
OVERSEAS_MINIO_ACCESS_KEY=
OVERSEAS_MINIO_SECRET_KEY=
OVERSEAS_MINIO_BUCKET=hengxin-overseas
# Without Compose, also explicitly supply these settings in the process environment:
# OVERSEAS_DATABASE_URL=postgresql+psycopg://overseas_app:<encoded-password>@<host>:5432/hengxin_overseas
# OVERSEAS_REDIS_URL=redis://:<encoded-password>@<host>:6379/0
# OVERSEAS_MINIO_ENDPOINT=<host>:9000
# OVERSEAS_MINIO_SECURE=true
# OVERSEAS_CODEX_EXECUTION_ROOT=/var/lib/hengxin-overseas/execution
# OVERSEAS_SKILL_INSTALL_ROOT=/var/lib/hengxin-overseas/skills
# OVERSEAS_LOCAL_SKILL_ROOT=/var/lib/hengxin-overseas/local-skills
# OVERSEAS_GENERATION_CONCURRENCY=5
# OVERSEAS_ENABLE_CODEX_EXECUTOR=false
# OVERSEAS_ENABLE_FIXTURE_EXECUTOR=false
# OVERSEAS_ENABLE_TEST_JOBS=false
# OVERSEAS_ENABLE_DEV_IDENTITY=false
# OVERSEAS_CLI_RETENTION_ENABLED=false
# Only for the explicit python -m app.overseas.members.bootstrap command.
# Comma-separated verified provider user IDs; never inherited from domestic roles.
OVERSEAS_BOOTSTRAP_ADMIN_CORP_ID=
OVERSEAS_BOOTSTRAP_ADMIN_USER_IDS=
